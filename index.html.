*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    background:
        radial-gradient(
            circle at 50% -20%,
            #1d477d 0%,
            #0d2b55 28%,
            #061a37 60%,
            #020a18 100%
        );
    color:#fff;
    font-family:'Inter',sans-serif;
    padding:14px 10px 24px;
}

.page{
    width:100%;
    max-width:380px;
    margin:0 auto;
}

.header{
    text-align:center;
    margin-bottom:13px;
}

.logo{
    width:30px;
    height:30px;
    margin:0 auto 6px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid #d9ad32;
    border-radius:50%;
    background:#061a36;
    color:#e4b83f;
    font-family:'Playfair Display',serif;
    font-size:10px;
    font-weight:700;
    box-shadow:0 0 15px rgba(217,173,50,.12);
}

.team-name{
    color:#e4b83f;
    font-family:'Playfair Display',serif;
    font-size:18px;
    font-weight:700;
    line-height:1.15;
    letter-spacing:.8px;
}

.subtitle{
    margin-top:4px;
    color:#9caabd;
    font-size:6.5px;
    font-weight:600;
    letter-spacing:1.9px;
    text-transform:uppercase;
}

.header-line{
    width:35px;
    height:1px;
    margin:7px auto 0;
    background:#d9ad32;
    box-shadow:0 0 7px rgba(217,173,50,.45);
}

.card{
    position:relative;
    width:100%;
    overflow:hidden;
    background:
        linear-gradient(
            145deg,
            rgba(10,39,77,.98),
            rgba(3,16,35,.99)
        );
    border:1px solid rgba(217,173,50,.55);
    border-radius:15px;
    box-shadow:0 15px 35px rgba(0,0,0,.30);
}

.card::before{
    content:"";
    position:absolute;
    top:0;
    left:15%;
    right:15%;
    height:1px;
    background:#e2b83f;
    opacity:.8;
}

.profile{
    text-align:center;
    padding:17px 13px 14px;
}

.avatar{
    width:52px;
    height:52px;
    margin:0 auto 8px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    border:1px solid #d9ad32;
    background:
        radial-gradient(
            circle,
            #194579,
            #061832
        );
    color:#e4b83f;
    font-family:'Playfair Display',serif;
    font-size:23px;
    font-weight:700;
}

.verified{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:4px;
    margin-bottom:5px;
    color:#8494aa;
    font-size:6.5px;
    font-weight:600;
    letter-spacing:1px;
    text-transform:uppercase;
}

.verified-dot{
    width:4px;
    height:4px;
    border-radius:50%;
    background:#d9ad32;
    box-shadow:0 0 5px rgba(217,173,50,.6);
}

.member-name{
    color:#fff;
    font-family:'Playfair Display',serif;
    font-size:18px;
    font-weight:600;
    line-height:1.25;
    margin-bottom:7px;
}

.position{
    display:inline-block;
    padding:4px 15px;
    border-radius:20px;
    background:
        linear-gradient(
            135deg,
            #e9c454,
            #c79620
        );
    color:#061832;
    font-size:7px;
    font-weight:700;
    letter-spacing:1px;
}

.member-meta{
    display:grid;
    grid-template-columns:1fr 1fr;
    border-top:1px solid rgba(217,173,50,.14);
    border-bottom:1px solid rgba(217,173,50,.14);
}

.meta{
    text-align:center;
    padding:9px 5px;
}

.meta:first-child{
    border-right:1px solid rgba(217,173,50,.14);
}

.meta-label{
    display:block;
    color:#718199;
    font-size:6px;
    font-weight:600;
    letter-spacing:.8px;
    text-transform:uppercase;
    margin-bottom:3px;
}

.meta-value{
    color:#dfb53e;
    font-size:8.5px;
    font-weight:600;
    letter-spacing:.4px;
}

.private{
    padding:13px;
}

.private-heading{
    text-align:center;
    margin-bottom:9px;
}

.private-icon{
    width:28px;
    height:28px;
    margin:0 auto 5px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(217,173,50,.35);
    border-radius:50%;
